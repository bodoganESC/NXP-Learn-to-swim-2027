# Medii virtuale Python
venv/
.venv/
env/

# Cache și fișiere compilate Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Binare C++ compilate local pentru pixy2sim (fiecare coleg le compilează pe OS-ul lui)
*.so
*.pyd
*.o
*.obj
*.dll
*.lib
*.exp

# Capturi de ecran, imagini și log-uri generate de simulator
sim24/snap/
snap/
*.log
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.webp
*.svg

# Documentație grea, datasheet-uri, arhive și fișiere Office (păstrați-le pe Google Drive)
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx
*.zip
*.7z
*.rar
*.tar
*.gz

# Excepție opțională: permite doar fișierele Markdown din docs/ (șterge linia dacă nu vrei)
!docs/*.md

# IDE-uri și sistem de operare
.idea/
.vscode/
.DS_Store
Thumbs.db